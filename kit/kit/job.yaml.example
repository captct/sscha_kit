# Portable Multi-Stage SSCHA + Dynamic Worker-Pool Job Card
# Copy to your calculation directory as `job.yaml`, edit parameters, then run:
#   sscha-check   (dry-run verification, no job submitted)
#   sscha-run     (launch automated workflow)

job_name: "System_25GPa"          # <= 15 chars (PBS/SLURM job name limit)
profile: "auto"                   # auto = use current cluster's default profile (zero edits across clusters)
# queue: "batch"                  # Optional: override queue name without editing profiles.yaml

# ---- Node Budget & Execution Mode ----
execution_mode: "worker_pool"     # worker_pool (recommended: dynamic work-stealing, zero polling gap) | batch
max_nodes: 4                      # Total concurrent nodes cap (set to your available node quota)
nodes_per_job: 1                  # Nodes per single pw.x configuration (set >= 2 for multi-node MPI)
# worker_walltime: "24:00:00"     # Optional: omit on clusters without walltime limits
# walltime: "08:00:00"            # Optional: batch-mode per-job walltime
check_timeout: 30                 # Progress polling interval (seconds)

# ---- Initial Harmonic Dynamical Matrices & Thermodynamic Conditions ----
init_dyn_prefix: "harmonic_dyn"   # Reads harmonic_dyn0 and harmonic_dyn1..nqirr
nqirr: 6
temperature: 0.0                  # Temperature in K (0.0 = pure quantum zero-point)
target_press_gpa: 25.0            # Target pressure in GPa (comment out for fixed-volume SSCHA)
bulk_modulus: 250.0               # Static bulk modulus estimate (GPa) for vc_relax step sizing

# ---- Multi-Stage Coarse-to-Dense Schedule ----
# Within each `vc_relax: true` stage, SSCHA couples atomic + force-constant relaxation
# with cell updates until both gradients and target pressure converge.
# A final `vc_relax: false` stage fixes the converged cell for high-N Hessian refinement.
stages:
  - name: "stage1_coarse"
    n_configs: 100
    max_pop: 6
    supercell_kpts: [2, 2, 2]
    conv_thr: 1.0e-6
    vc_relax: true
    kong_liu_ratio: 0.5
    meaningful_factor: 0.2

  - name: "stage2_medium"
    n_configs: 200
    max_pop: 5
    supercell_kpts: [4, 4, 4]
    conv_thr: 1.0e-7
    vc_relax: true
    kong_liu_ratio: 0.5
    meaningful_factor: 0.1

  - name: "stage3_hessian"
    n_configs: 400
    max_pop: 2
    supercell_kpts: [6, 6, 6]
    conv_thr: 1.0e-8
    vc_relax: false
    kong_liu_ratio: 0.8
    meaningful_factor: 0.05

# ---- Minimizer & Acceptance Controls (global defaults, overridable per stage) ----
root_representation: "sqrt"       # "normal" | "sqrt" | "root4"
preconditioning: true             # Precondition atomic & force-constant gradients
min_step_dyn: 0.05                # Force-constant step size (alias: lambda_a)
min_step_struc: 0.1               # Atomic-centroid step size (alias: lambda_w)
minim_struct: true                # Relax average atomic positions (alias: minim_struc)
minim_dyn: true                   # Relax force constants
kong_liu_ratio: 0.5               # Effective sample ratio threshold (or specify n_random_eff)
meaningful_factor: 0.05           # Convergence criterion |grad| / error < meaningful_factor
gradi_op: "all"                   # Gradient monitor: "all" | "dyn" | "struc"
max_ka: 200                       # Max line-search steps per population
compute_hessian: true             # Compute D2+D3 free-energy Hessian after final stage
hessian_error_blocks: 10          # Delete-block Jackknife error bars (+/- SE) at zero extra DFT cost
resume_from_stage: "auto"         # auto = 4-level crash/outage recovery; 0 = force clean start

# ---- Quantum ESPRESSO Single-Point SCF Settings ----
ecutwfc: 80
ecutrho: 800
occupations: "smearing"
smearing: "mv"
degauss: 0.02
mixing_beta: 0.3
electron_maxstep: 200
nosym: true
noinv: false

# ---- Phonon Dispersion Plotting Path (optional, auto-detected via ASE if omitted) ----
bandpath: "GXMGZRAZ"
special_points:
  G: [0.0, 0.0, 0.0]
  X: [0.0, 0.0, 0.5]
  M: [0.0, 0.5, 0.5]
  Z: [0.5, 0.0, 0.0]
  R: [0.5, 0.0, 0.5]
  A: [0.5, 0.5, 0.5]

# ---- Pseudopotentials (keep consistent with initial harmonic_dyn!) ----
pseudo_dir: "./pseudo"
pseudos:
  H: "H.pbe-kjpaw_psl.1.0.0.UPF"
  Cu: "Cu.pbe-spn-kjpaw_psl.1.0.0.UPF"
  Pd: "Pd.pbe-n-kjpaw_psl.1.0.0.UPF"
